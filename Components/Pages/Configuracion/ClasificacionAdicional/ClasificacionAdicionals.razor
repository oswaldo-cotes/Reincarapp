@page "/clasificacion-adicionals"
@attribute [Authorize(Roles="Administrador")]
@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager
@inject DialogService DialogService
@inject ContextMenuService ContextMenuService
@inject TooltipService TooltipService
@inject NotificationService NotificationService

@inject reincardbService reincardbService

<PageTitle>ClasificacionAdicionals</PageTitle>
<RadzenStack>
    <RadzenRow AlignItems="AlignItems.Center">
        <RadzenColumn Size="12" SizeMD="6">
            <RadzenText Text="ClasificacionAdicionals" TextStyle="TextStyle.H3" TagName="TagName.H1" style="margin: 0" />
        </RadzenColumn>
        <RadzenColumn Size="12" SizeMD="6">
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.End" Gap="0.5rem">
                <RadzenSplitButton Icon="get_app" Text="Export" Click="@ExportClick" Variant="Variant.Flat" Shade="Shade.Lighter">
                    <RadzenSplitButtonItem Text="Excel" Value="xlsx" />
                    <RadzenSplitButtonItem Text="CSV" Value="csv" />
                </RadzenSplitButton>
                <RadzenButton Icon="add_circle_outline" Text="Add" Click="@AddButtonClick" Variant="Variant.Flat" />
            </RadzenStack>
        </RadzenColumn>
    </RadzenRow>
    <RadzenTextBox Placeholder="Search ..." style="display: block; width: 100%" @oninput="@Search" />
    <RadzenRow>
      <RadzenColumn SizeMD=12>
        <RadzenDataGrid @ref="grid0" ColumnWidth="200px"  AllowFiltering="true" FilterMode="FilterMode.Advanced" AllowPaging="true" AllowSorting="true" ShowPagingSummary="true" PageSizeOptions=@(new int[]{5, 10, 20, 30})
            Data="@clasificacionAdicionals"    TItem="Reincarapp.Models.reincardb.ClasificacionAdicional" RowDoubleClick="@EditRow" >
            <Columns>
                <RadzenDataGridColumn TItem="Reincarapp.Models.reincardb.ClasificacionAdicional" Property="Cliente.Nombre_Cliente" Title="Cliente">
                                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="Reincarapp.Models.reincardb.ClasificacionAdicional" Property="Nombre_Clasificacion_Adicional" Title="Nombre Clasificacion Adicional">
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="Reincarapp.Models.reincardb.ClasificacionAdicional" Property="Tipo" Title="Tipo">
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="Reincarapp.Models.reincardb.ClasificacionAdicional" Property="Identificador_Cliente" Title="Identificador Cliente">
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="Reincarapp.Models.reincardb.ClasificacionAdicional" Property="dato_adicional_1" Title="datoadicional1">
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="Reincarapp.Models.reincardb.ClasificacionAdicional" Property="dato_adicional_2" Title="datoadicional2">
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="Reincarapp.Models.reincardb.ClasificacionAdicional" Property="dato_adicional_3" Title="datoadicional3">
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="Reincarapp.Models.reincardb.ClasificacionAdicional" Property="TipoClasificacionAdicional.Nombre" Title="Tipo Clasificacion Adicional">
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="Reincarapp.Models.reincardb.ClasificacionAdicional" Filterable="false" Sortable="false" Width="70px" TextAlign="TextAlign.Center">
                    <Template Context="clasificacionAdicional">

                        <RadzenButton ButtonStyle="ButtonStyle.Danger" Icon="delete" Size="ButtonSize.Medium"
                            Shade="Shade.Lighter" Variant="Variant.Flat"
                            Click=@(args => GridDeleteButtonClick(args, clasificacionAdicional)) @onclick:stopPropagation="true" />
                    </Template>
                </RadzenDataGridColumn>
            </Columns>

        </RadzenDataGrid>

    </RadzenColumn>
  </RadzenRow>
</RadzenStack>
@code {

    protected IEnumerable<Reincarapp.Models.reincardb.ClasificacionAdicional> clasificacionAdicionals;

    protected RadzenDataGrid<Reincarapp.Models.reincardb.ClasificacionAdicional> grid0;

    protected string search = "";

    protected async Task Search(ChangeEventArgs args)
    {
        search = $"{args.Value}";

        await grid0.GoToPage(0);

        clasificacionAdicionals = await reincardbService.GetClasificacionAdicional(new Query { Filter = $@"i => i.Nombre_Clasificacion_Adicional.Contains(@0) || i.Tipo.Contains(@0) || i.Identificador_Cliente.Contains(@0) || i.dato_adicional_1.Contains(@0) || i.dato_adicional_2.Contains(@0) || i.dato_adicional_3.Contains(@0)", FilterParameters = new object[] { search }, Expand = "Cliente,TipoClasificacionAdicional" });
    }
    protected override async Task OnInitializedAsync()
    {
        clasificacionAdicionals = await reincardbService.GetClasificacionAdicional(new Query { Filter = $@"i => i.Nombre_Clasificacion_Adicional.Contains(@0) || i.Tipo.Contains(@0) || i.Identificador_Cliente.Contains(@0) || i.dato_adicional_1.Contains(@0) || i.dato_adicional_2.Contains(@0) || i.dato_adicional_3.Contains(@0)", FilterParameters = new object[] { search }, Expand = "Cliente,TipoClasificacionAdicional" });
    }

    protected async Task AddButtonClick(MouseEventArgs args)
    {
        await DialogService.OpenAsync<AddClasificacionAdicional>("Add ClasificacionAdicional", null);
        await grid0.Reload();
    }

    protected async Task EditRow(DataGridRowMouseEventArgs<Reincarapp.Models.reincardb.ClasificacionAdicional> args)
    {
        await DialogService.OpenAsync<EditClasificacionAdicional>("Edit ClasificacionAdicional", new Dictionary<string, object> { {"Id_Clasificacion_Adicional", args.Data.Id_Clasificacion_Adicional} });
    }

    protected async Task GridDeleteButtonClick(MouseEventArgs args, Reincarapp.Models.reincardb.ClasificacionAdicional clasificacionAdicional)
    {
        try
        {
            if (await DialogService.Confirm("Are you sure you want to delete this record?") == true)
            {
                var deleteResult = await reincardbService.DeleteClasificacionAdicional(clasificacionAdicional.Id_Clasificacion_Adicional);

                if (deleteResult != null)
                {
                    await grid0.Reload();
                }
            }
        }
        catch (Exception ex)
        {
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = $"Error",
                Detail = $"Unable to delete ClasificacionAdicional"
            });
        }
    }

    protected async Task ExportClick(RadzenSplitButtonItem args)
    {
        if (args?.Value == "csv")
        {
            await reincardbService.ExportClasificacionAdicionalToCSV(new Query
        {
            Filter = $@"{(string.IsNullOrEmpty(grid0.Query.Filter)? "true" : grid0.Query.Filter)}",
            OrderBy = $"{grid0.Query.OrderBy}",
            Expand = "Cliente,TipoClasificacionAdicional",
            Select = string.Join(",", grid0.ColumnsCollection.Where(c => c.GetVisible() && !string.IsNullOrEmpty(c.Property)).Select(c => c.Property.Contains(".") ? c.Property + " as " + c.Property.Replace(".", "") : c.Property))
        }, "ClasificacionAdicionals");
        }

        if (args == null || args.Value == "xlsx")
        {
            await reincardbService.ExportClasificacionAdicionalToExcel(new Query
        {
            Filter = $@"{(string.IsNullOrEmpty(grid0.Query.Filter)? "true" : grid0.Query.Filter)}",
            OrderBy = $"{grid0.Query.OrderBy}",
            Expand = "Cliente,TipoClasificacionAdicional",
            Select = string.Join(",", grid0.ColumnsCollection.Where(c => c.GetVisible() && !string.IsNullOrEmpty(c.Property)).Select(c => c.Property.Contains(".") ? c.Property + " as " + c.Property.Replace(".", "") : c.Property))
        }, "ClasificacionAdicionals");
        }
    }
}
