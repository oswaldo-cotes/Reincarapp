@page "/resultado-eventos"
@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager
@inject DialogService DialogService
@inject ContextMenuService ContextMenuService
@inject TooltipService TooltipService
@inject NotificationService NotificationService
@attribute [Authorize(Roles="Administrador")]

@inject reincardbService reincardbService

<PageTitle>ResultadoEventos</PageTitle>
<RadzenStack>
    <RadzenRow AlignItems="AlignItems.Center">
        <RadzenColumn Size="12" SizeMD="6">
            <RadzenText Text="ResultadoEventos" TextStyle="TextStyle.H3" TagName="TagName.H1" style="margin: 0" />
        </RadzenColumn>
        <RadzenColumn Size="12" SizeMD="6">
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.End" Gap="0.5rem">
                <RadzenSplitButton Icon="get_app" Text="Export" Click="@ExportClick" Variant="Variant.Flat" Shade="Shade.Lighter">
                    <RadzenSplitButtonItem Text="Excel" Value="xlsx" />
                    <RadzenSplitButtonItem Text="CSV" Value="csv" />
                </RadzenSplitButton>
                <RadzenButton Icon="add_circle_outline" Text="Add" Click="@AddButtonClick" Variant="Variant.Flat" />
            </RadzenStack>
        </RadzenColumn>
    </RadzenRow>
    <RadzenTextBox Placeholder="Search ..." style="display: block; width: 100%" @oninput="@Search" />
    <RadzenRow>
      <RadzenColumn SizeMD=12>
        <RadzenDataGrid @ref="grid0" ColumnWidth="200px"  AllowFiltering="true" FilterMode="FilterMode.Advanced" AllowPaging="true" AllowSorting="true" ShowPagingSummary="true" PageSizeOptions=@(new int[]{5, 10, 20, 30})
            Data="@resultadoEventos"    TItem="Reincarapp.Models.reincardb.ResultadoEvento" RowDoubleClick="@EditRow" >
            <Columns>
                <RadzenDataGridColumn TItem="Reincarapp.Models.reincardb.ResultadoEvento" Property="Nombre_Resultado_Evento" Title="Nombre Resultado Evento">
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="Reincarapp.Models.reincardb.ResultadoEvento" Property="Cliente.Nombre_Cliente" Title="Cliente">
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="Reincarapp.Models.reincardb.ResultadoEvento" Property="Inactiva_Tipo_Comunicacion" Title="Inactiva Tipo Comunicacion">
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="Reincarapp.Models.reincardb.ResultadoEvento" Property="Crea_Tarea_Automatica" Title="Crea Tarea Automatica">
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="Reincarapp.Models.reincardb.ResultadoEvento" Property="Valor_Exito" Title="Valor Exito">
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="Reincarapp.Models.reincardb.ResultadoEvento" Property="Id_Negocio_Cliente" Title="Id Negocio Cliente">
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="Reincarapp.Models.reincardb.ResultadoEvento" Property="Es_Contacto" Title="Es Contacto">
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="Reincarapp.Models.reincardb.ResultadoEvento" Property="Conexion_Informe_Diario" Title="Conexion Informe Diario">
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="Reincarapp.Models.reincardb.ResultadoEvento" Property="Contacto_Informe_Diario" Title="Contacto Informe Diario">
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="Reincarapp.Models.reincardb.ResultadoEvento" Property="Contacto_Directo_Informe_Diario" Title="Contacto Directo Informe Diario">
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="Reincarapp.Models.reincardb.ResultadoEvento" Property="Promesa_Levantada" Title="Promesa Levantada">
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="Reincarapp.Models.reincardb.ResultadoEvento" Property="Promesa_Efectiva" Title="Promesa Efectiva">
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="Reincarapp.Models.reincardb.ResultadoEvento" Property="Codificacion_Tipificacion" Title="Codificacion Tipificacion">
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="Reincarapp.Models.reincardb.ResultadoEvento" Property="Envio_Actualizador" Title="Envio Actualizador">
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="Reincarapp.Models.reincardb.ResultadoEvento" Property="Es_Recaudo" Title="Es Recaudo">
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="Reincarapp.Models.reincardb.ResultadoEvento" Property="Es_Compromiso" Title="Es Compromiso">
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="Reincarapp.Models.reincardb.ResultadoEvento" Property="No_Enviar_En_Informe" Title="No Enviar En Informe">
                </RadzenDataGridColumn>
                
                
                <RadzenDataGridColumn TItem="Reincarapp.Models.reincardb.ResultadoEvento" Filterable="false" Sortable="false" Width="70px" TextAlign="TextAlign.Center">
                    <Template Context="resultadoEvento">

                        <RadzenButton ButtonStyle="ButtonStyle.Danger" Icon="delete" Size="ButtonSize.Medium"
                            Shade="Shade.Lighter" Variant="Variant.Flat"
                            Click=@(args => GridDeleteButtonClick(args, resultadoEvento)) @onclick:stopPropagation="true" />
                    </Template>
                </RadzenDataGridColumn>
            </Columns>

        </RadzenDataGrid>

    </RadzenColumn>
  </RadzenRow>
</RadzenStack>
@code {

    protected IEnumerable<Reincarapp.Models.reincardb.ResultadoEvento> resultadoEventos;

    protected RadzenDataGrid<Reincarapp.Models.reincardb.ResultadoEvento> grid0;

    protected string search = "";

    protected async Task Search(ChangeEventArgs args)
    {
        search = $"{args.Value}";

        await grid0.GoToPage(0);

        resultadoEventos = await reincardbService.GetResultadoEvento(new Query { Filter = $@"i => i.Nombre_Resultado_Evento.Contains(@0) || i.Id_Negocio_Cliente.Contains(@0)", FilterParameters = new object[] { search }, Expand = "Cliente" });
    }
    protected override async Task OnInitializedAsync()
    {
        resultadoEventos = await reincardbService.GetResultadoEvento(new Query { Filter = $@"i => i.Nombre_Resultado_Evento.Contains(@0) || i.Id_Negocio_Cliente.Contains(@0)", FilterParameters = new object[] { search }, Expand = "Cliente" });
    }

    protected async Task AddButtonClick(MouseEventArgs args)
    {
        await DialogService.OpenAsync<AddResultadoEvento>("Add ResultadoEvento", null);
        await grid0.Reload();
    }

    protected async Task EditRow(DataGridRowMouseEventArgs<Reincarapp.Models.reincardb.ResultadoEvento> args)
    {
        await DialogService.OpenAsync<EditResultadoEvento>("Edit ResultadoEvento", new Dictionary<string, object> { {"Id_Resultado_Evento", args.Data.Id_Resultado_Evento} });
    }

    protected async Task GridDeleteButtonClick(MouseEventArgs args, Reincarapp.Models.reincardb.ResultadoEvento resultadoEvento)
    {
        try
        {
            if (await DialogService.Confirm("Are you sure you want to delete this record?") == true)
            {
                var deleteResult = await reincardbService.DeleteResultadoEvento(resultadoEvento.Id_Resultado_Evento);

                if (deleteResult != null)
                {
                    await grid0.Reload();
                }
            }
        }
        catch (Exception ex)
        {
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = $"Error",
                Detail = $"Unable to delete ResultadoEvento"
            });
        }
    }

    protected async Task ExportClick(RadzenSplitButtonItem args)
    {
        if (args?.Value == "csv")
        {
            await reincardbService.ExportResultadoEventoToCSV(new Query
        {
            Filter = $@"{(string.IsNullOrEmpty(grid0.Query.Filter)? "true" : grid0.Query.Filter)}",
            OrderBy = $"{grid0.Query.OrderBy}",
            Expand = "Cliente",
            Select = string.Join(",", grid0.ColumnsCollection.Where(c => c.GetVisible() && !string.IsNullOrEmpty(c.Property)).Select(c => c.Property.Contains(".") ? c.Property + " as " + c.Property.Replace(".", "") : c.Property))
        }, "ResultadoEventos");
        }

        if (args == null || args.Value == "xlsx")
        {
            await reincardbService.ExportResultadoEventoToExcel(new Query
        {
            Filter = $@"{(string.IsNullOrEmpty(grid0.Query.Filter)? "true" : grid0.Query.Filter)}",
            OrderBy = $"{grid0.Query.OrderBy}",
            Expand = "Cliente",
            Select = string.Join(",", grid0.ColumnsCollection.Where(c => c.GetVisible() && !string.IsNullOrEmpty(c.Property)).Select(c => c.Property.Contains(".") ? c.Property + " as " + c.Property.Replace(".", "") : c.Property))
        }, "ResultadoEventos");
        }
    }
}
