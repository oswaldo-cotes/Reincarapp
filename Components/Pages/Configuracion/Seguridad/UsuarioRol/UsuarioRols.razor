@page "/usuario-rols"
@attribute [Authorize(Roles="Administrador")]
@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager
@inject DialogService DialogService
@inject ContextMenuService ContextMenuService
@inject TooltipService TooltipService
@inject NotificationService NotificationService

@inject reincardbService reincardbService

<PageTitle>UsuarioRols</PageTitle>
<RadzenStack>
    <RadzenRow AlignItems="AlignItems.Center">
        <RadzenColumn Size="12" SizeMD="6">
            <RadzenText Text="UsuarioRols" TextStyle="TextStyle.H3" TagName="TagName.H1" style="margin: 0" />
        </RadzenColumn>
        <RadzenColumn Size="12" SizeMD="6">
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.End" Gap="0.5rem">
                <RadzenSplitButton Icon="get_app" Text="Export" Click="@ExportClick" Variant="Variant.Flat" Shade="Shade.Lighter">
                    <RadzenSplitButtonItem Text="Excel" Value="xlsx" />
                    <RadzenSplitButtonItem Text="CSV" Value="csv" />
                </RadzenSplitButton>
                <RadzenButton Icon="add_circle_outline" Text="Add" Click="@AddButtonClick" Variant="Variant.Flat" />
            </RadzenStack>
        </RadzenColumn>
    </RadzenRow>
    <RadzenTextBox Placeholder="Search ..." style="display: block; width: 100%" @oninput="@Search" />
    <RadzenRow>
      <RadzenColumn SizeMD=12>
        <RadzenDataGrid @ref="grid0" ColumnWidth="200px"  AllowFiltering="true" FilterMode="FilterMode.Advanced" AllowPaging="true" AllowSorting="true" ShowPagingSummary="true" PageSizeOptions=@(new int[]{5, 10, 20, 30})
            Data="@usuarioRols"    TItem="Reincarapp.Models.reincardb.UsuarioRol" RowDoubleClick="@EditRow" >
            <Columns>
                <RadzenDataGridColumn TItem="Reincarapp.Models.reincardb.UsuarioRol" Property="Rol.Nombre_Rol" Title="Rol">
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="Reincarapp.Models.reincardb.UsuarioRol" Property="Usuario.Nombre_Usuario" Title="Usuario">
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="Reincarapp.Models.reincardb.UsuarioRol" Filterable="false" Sortable="false" Width="70px" TextAlign="TextAlign.Center">
                    <Template Context="usuarioRol">

                        <RadzenButton ButtonStyle="ButtonStyle.Danger" Icon="delete" Size="ButtonSize.Medium"
                            Shade="Shade.Lighter" Variant="Variant.Flat"
                            Click=@(args => GridDeleteButtonClick(args, usuarioRol)) @onclick:stopPropagation="true" />
                    </Template>
                </RadzenDataGridColumn>
            </Columns>

        </RadzenDataGrid>

    </RadzenColumn>
  </RadzenRow>
</RadzenStack>
@code {

    [Parameter]
    public long Id_Usuario { get; set; }

    protected IEnumerable<Reincarapp.Models.reincardb.UsuarioRol> usuarioRols;

    protected RadzenDataGrid<Reincarapp.Models.reincardb.UsuarioRol> grid0;

    protected string search = "";

    protected async Task Search(ChangeEventArgs args)
    {
        search = $"{args.Value}";

        await grid0.GoToPage(0);

        usuarioRols = await reincardbService.GetUsuarioRol(new Query { Expand = "Rol,Usuario" });
    }
    protected override async Task OnInitializedAsync()
    {
        if (Id_Usuario > 0)
            usuarioRols = (await reincardbService.GetUsuarioRol(new Query { Expand = "Rol,Usuario" })).Where(x => x.Id_Usuario == this.Id_Usuario);
        else
            usuarioRols = (await reincardbService.GetUsuarioRol(new Query { Expand = "Rol,Usuario" }));
    }

    protected async Task AddButtonClick(MouseEventArgs args)
    {
        await DialogService.OpenAsync<AddUsuarioRol>("Add UsuarioRol", new Dictionary<string, object> { {"Id_Usuario", this.Id_Usuario}});
        await grid0.Reload();
    }

    protected async Task EditRow(DataGridRowMouseEventArgs<Reincarapp.Models.reincardb.UsuarioRol> args)
    {
        await DialogService.OpenAsync<EditUsuarioRol>("Edit UsuarioRol", new Dictionary<string, object> { {"Id_Usuario_Rol", args.Data.Id_Usuario_Rol} });
    }

    protected async Task GridDeleteButtonClick(MouseEventArgs args, Reincarapp.Models.reincardb.UsuarioRol usuarioRol)
    {
        try
        {
            if (await DialogService.Confirm("Are you sure you want to delete this record?") == true)
            {
                var deleteResult = await reincardbService.DeleteUsuarioRol(usuarioRol.Id_Usuario_Rol);

                if (deleteResult != null)
                {
                    await grid0.Reload();
                }
            }
        }
        catch (Exception ex)
        {
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = $"Error",
                Detail = $"Unable to delete UsuarioRol"
            });
        }
    }

    protected async Task ExportClick(RadzenSplitButtonItem args)
    {
        if (args?.Value == "csv")
        {
            await reincardbService.ExportUsuarioRolToCSV(new Query
        {
            Filter = $@"{(string.IsNullOrEmpty(grid0.Query.Filter)? "true" : grid0.Query.Filter)}",
            OrderBy = $"{grid0.Query.OrderBy}",
            Expand = "Rol,Usuario",
            Select = string.Join(",", grid0.ColumnsCollection.Where(c => c.GetVisible() && !string.IsNullOrEmpty(c.Property)).Select(c => c.Property.Contains(".") ? c.Property + " as " + c.Property.Replace(".", "") : c.Property))
        }, "UsuarioRols");
        }

        if (args == null || args.Value == "xlsx")
        {
            await reincardbService.ExportUsuarioRolToExcel(new Query
        {
            Filter = $@"{(string.IsNullOrEmpty(grid0.Query.Filter)? "true" : grid0.Query.Filter)}",
            OrderBy = $"{grid0.Query.OrderBy}",
            Expand = "Rol,Usuario",
            Select = string.Join(",", grid0.ColumnsCollection.Where(c => c.GetVisible() && !string.IsNullOrEmpty(c.Property)).Select(c => c.Property.Contains(".") ? c.Property + " as " + c.Property.Replace(".", "") : c.Property))
        }, "UsuarioRols");
        }
    }
}
