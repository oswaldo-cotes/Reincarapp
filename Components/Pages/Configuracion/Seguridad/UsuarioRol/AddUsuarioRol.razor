@page "/add-usuario-rol"
@attribute [Authorize(Roles="Administrador")]
@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager
@inject DialogService DialogService
@inject ContextMenuService ContextMenuService
@inject TooltipService TooltipService
@inject NotificationService NotificationService

@inject reincardbService reincardbService

<PageTitle>Add UsuarioRol</PageTitle>
    <RadzenColumn SizeMD=12>
        <RadzenAlert Shade="Shade.Lighter" Variant="Variant.Flat" Size="AlertSize.Small" AlertStyle="AlertStyle.Danger" Visible="@errorVisible">Cannot save UsuarioRol</RadzenAlert>
        <RadzenTemplateForm TItem="Reincarapp.Models.reincardb.UsuarioRol" Data="@usuarioRol" Visible="@(usuarioRol != null && canEdit)" Submit="@FormSubmit">
          <RadzenStack>
            <RadzenFormField Text="Rol" Variant="Variant.Text">
                  <ChildContent>
                    <RadzenDropDownDataGrid Data="@rolsForIdRol" TextProperty="Nombre_Rol" ValueProperty="Id_Rol" AllowClear=true
                          style="display: block; width: 100%" @bind-Value="@usuarioRol.Id_Rol" Name="Id_Rol"
                           />
              </ChildContent>
            </RadzenFormField>
            <RadzenFormField Text="Usuario" Variant="Variant.Text">
                  <ChildContent>
                    <RadzenDropDownDataGrid Data="@usuariosForIdUsuario" TextProperty="Nombre_Usuario" ValueProperty="Id_Usuario" AllowClear=true
                          style="display: block; width: 100%" @bind-Value="@usuarioRol.Id_Usuario" Name="Id_Usuario"
                           />
              </ChildContent>
            </RadzenFormField>
          </RadzenStack>
          <RadzenStack style="margin-top:1rem;" Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.End" Gap="0.5rem">
                    <RadzenButton ButtonStyle="ButtonStyle.Primary" ButtonType="ButtonType.Submit" Icon="save" Text="Save" Variant="Variant.Flat" />
                    <RadzenButton ButtonStyle="ButtonStyle.Light" Text="Cancel" Variant="Variant.Flat" Click="@CancelButtonClick"  />
          </RadzenStack>
        </RadzenTemplateForm>
    </RadzenColumn>

@code {

    [Parameter]
    public long Id_Usuario { get; set; }

    protected override async Task OnInitializedAsync()
    {
        usuarioRol = new Reincarapp.Models.reincardb.UsuarioRol() { Id_Usuario = this.Id_Usuario};

        rolsForIdRol = await reincardbService.GetRol();

        usuariosForIdUsuario = await reincardbService.GetUsuario();
    }
    protected bool errorVisible;
    protected Reincarapp.Models.reincardb.UsuarioRol usuarioRol;

    protected IEnumerable<Reincarapp.Models.reincardb.Rol> rolsForIdRol;

    protected IEnumerable<Reincarapp.Models.reincardb.Usuario> usuariosForIdUsuario;

    protected async Task FormSubmit()
    {
        try
        {
            await reincardbService.CreateUsuarioRol(usuarioRol);
            DialogService.Close(usuarioRol);
        }
        catch (Exception ex)
        {
            hasChanges = ex is Microsoft.EntityFrameworkCore.DbUpdateConcurrencyException;
            canEdit = !(ex is Microsoft.EntityFrameworkCore.DbUpdateConcurrencyException);
            errorVisible = true;
        }
    }

    protected async Task CancelButtonClick(MouseEventArgs args)
    {
        DialogService.Close(null);
    }


    protected bool hasChanges = false;
    protected bool canEdit = true;
}
