    async Task GetUser()
    {
        try
        {

            var authToken =
            HttpContextAccessor.HttpContext.Request.Cookies[".AspNetCore.Cookies"];
            if (authToken != null)
            {
                Http.DefaultRequestHeaders
                .Add("Cookie", ".AspNetCore.Cookies=" + authToken);
                var url = UriHelper.ToAbsoluteUri("/api/User/GetUser");
                var r = await Http.GetAsync(url.ToString());
                string json = await r.Content.ReadAsStringAsync();
                CurrentUser = JsonConvert.DeserializeObject<BlazorApp1.Controllers.UserController.UserModel>(json);
                //CurrentUser = await Http.GetJsonAsync<BlazorApp1.Controllers.UserController.UserModel>(url.ToString());
            }
        }
        catch (Exception ex) { }

    }

