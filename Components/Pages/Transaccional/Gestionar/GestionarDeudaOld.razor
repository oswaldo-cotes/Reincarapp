public string GetTipoDato(object dato)
{
    string retVal = "";

    if (dato != null)
    {
        if (lstTipoDatP.Where(x => x.Id_Tipo_Dato_Persona == long.Parse(dato.ToString())).Count() > 0)
            retVal = lstTipoDatP.Where(x => x.Id_Tipo_Dato_Persona == long.Parse(dato.ToString())).FirstOrDefault().Nombre_Tipo_Dato_Persona;
    }
    else
    {
        retVal = "SIN TIPO";
    }
    return retVal;
}

