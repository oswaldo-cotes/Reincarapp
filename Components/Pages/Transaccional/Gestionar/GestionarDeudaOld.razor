int convertoInt(string valor)
{
    string dato = Regex.Match(valor, @"\d+").Value;
    int ret = 10000;

    if (!int.TryParse(dato, out ret))
        ret = 10000;

    return ret;

}



long convertoLng(string valor)
{
    long ret = 0;

    if (!long.TryParse(valor.Replace("$", "").Replace(",", "").Replace(".", ""), out ret))
        ret = 0;

    return ret;

}
