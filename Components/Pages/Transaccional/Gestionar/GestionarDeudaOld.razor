async void OnChange(bool? value, string name, object context)
{
    //console.Log($"{name} value changed to {value}");

    Reincarapp.Models.reincardb.DatoPersona datoper = ((Reincarapp.Models.reincardb.DatoPersona)context);
    datoper.Dato_Activo = (value ?? false) ? 1 : 0;

    using (Reincarapp.Data.reincardbContext db = new Reincarapp.Data.reincardbContext())
    {
        db.Entry(datoper).State = EntityState.Modified;
        await db.SaveChangesAsync();
    }
}

