    public async void DeleteRec(BlazorApp1.Data.Evento _context)
    {
        try
        {

            if (!await JSRuntime.InvokeAsync<bool>("confirm", $"esta seguro de borrar esta gestion?, recuerde que sera eliminada toda la informacion relacionada"))
                return;


            try
            {
                using (reincardbContext db = new reincardbContext())
                {
                    var evento = db.Evento.Where(x => x.IdEvento == _context.id_evento).FirstOrDefault();
                    db.ClienteDeudaCons.RemoveRange(db.ClienteDeudaCons.Where(x => x.IdEventoMejorGestion == _context.id_evento));
                    db.ClienteDeudaCons.RemoveRange(db.ClienteDeudaCons.Where(x => x.IdEventoUltimaGestion == _context.id_evento));
                    db.EventoArchivo.RemoveRange(db.EventoArchivo.Where(x => x.IdEvento == _context.id_evento));

                    db.Evento.Remove(evento);
                    await db.SaveChangesAsync();
                }
                await ShowNotification(new Radzen.NotificationMessage()
                {
                    Severity = Radzen.NotificationSeverity.Success,
                    Summary = "Actualizacion",
                    Detail = "Registro Correctamente eliminado",
                    Duration = 3500
                });

                lstEve = await todoItemService.GetEventoAsync(idCliDeuda);

                //await LoadData();

            }
            catch (Exception ex)
            {
                await ShowNotification(new Radzen.NotificationMessage()
                {
                    Severity = Radzen.NotificationSeverity.Error,
                    Summary = "Excepcion eliminacion",
                    Detail = ex.InnerException != null ? ex.InnerException.Message : ex.Message,
                    Duration = 3500
                });

            }
            //this.StateHasChanged();
        }
        catch (Exception ex)
        {
        }
    }


