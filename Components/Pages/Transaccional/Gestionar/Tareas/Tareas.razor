@code {

    protected IEnumerable<Reincarapp.Models.reincardb.Tarea> tareas;

    protected RadzenDataGrid<Reincarapp.Models.reincardb.Tarea> grid0;

    protected string search = "";

    [Parameter]
    public decimal ClienteDeudaId { get; set; }

    protected async Task Search(ChangeEventArgs args)
    {
        search = $"{args.Value}";

        await grid0.GoToPage(0);

        tareas = await reincardbService.GetTarea(new Query { Filter = $@"i => i.Texto_Tarea.Contains(@0)  && i.id_cliente_deuda == @1", FilterParameters = new object[] { search,ClienteDeudaId }, Expand = "ClienteDeudum,Evento,TipoComunicacion,TipoTarea,Usuario,Usuario1"});
    }
    protected override async Task OnInitializedAsync()
    {




    }


    protected async override Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Task.Delay(1000);
            tareas = await reincardbService.GetTarea(new Query { Filter = $@"i => i.id_cliente_deuda == @0", FilterParameters = new object[] { ClienteDeudaId }, Expand = "ClienteDeudum,Evento,TipoComunicacion,TipoTarea,Usuario,Usuario1" });
            //await grid0.Reload();
            this.StateHasChanged();



        }
    }

    protected async Task AddButtonClick(MouseEventArgs args)
    {
        await DialogService.OpenAsync<AddTarea>("Add Tarea", new Dictionary<string, object> { { "ClienteDeudaId", ClienteDeudaId } });
        await grid0.Reload();
    }

    protected async Task EditRow(DataGridRowMouseEventArgs<Reincarapp.Models.reincardb.Tarea> args)
    {
        await DialogService.OpenAsync<EditTarea>("Edit Tarea", new Dictionary<string, object> { {"Id_Tarea", args.Data.Id_Tarea} });
    }

    protected async Task GridDeleteButtonClick(MouseEventArgs args, Reincarapp.Models.reincardb.Tarea tarea)
    {
        try
        {


            var res = await DialogService.OpenAsync<Evento.AddEvento>("Add Evento", new Dictionary<string, object> { { "ClienteDeudaId", tarea.Id_Cliente_Deuda }, { "IdNegocio", "" }, { "IdTarea", tarea.Id_Tarea },{"screen","tarea" } }, new DialogOptions() { Draggable = true, Width = "700px", Height = "800px" });

            if (res != null)
            {

                 var t = await reincardbService.GetTareaByIdTarea(res.Id_Tarea);
                 var tareas_ = tareas.ToList();
                 var idx = tareas_.FindIndex(x => x.Id_Tarea == t.Id_Tarea);
                 tareas_.RemoveAt(idx);
                 tareas_.Insert(idx, t);
                 tareas = tareas_;


                await grid0.Reload();

            }

           


            // if (await DialogService.Confirm("Are you sure you want to delete this record?") == true)
            // {
            //     var deleteResult = await reincardbService.DeleteTarea(tarea.Id_Tarea);

            //     if (deleteResult != null)
            //     {
            //         await grid0.Reload();
            //     }
            // }
        }
        catch (Exception ex)
        {
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = $"Error",
                Detail = $"Unable to delete Tarea"
            });
        }
    }

    protected async Task ExportClick(RadzenSplitButtonItem args)
    {
        if (args?.Value == "csv")
        {
            await reincardbService.ExportTareaToCSV(new Query
{
    Filter = $@"{(string.IsNullOrEmpty(grid0.Query.Filter)? "true" : grid0.Query.Filter)}",
    OrderBy = $"{grid0.Query.OrderBy}",
    Expand = "ClienteDeudum,Evento,TipoComunicacion,TipoTarea,Usuario,Usuario1",
    Select = string.Join(",", grid0.ColumnsCollection.Where(c => c.GetVisible() && !string.IsNullOrEmpty(c.Property)).Select(c => c.Property.Contains(".") ? c.Property + " as " + c.Property.Replace(".", "") : c.Property))
}, "Tareas");
        }

        if (args == null || args.Value == "xlsx")
        {
            await reincardbService.ExportTareaToExcel(new Query
{
    Filter = $@"{(string.IsNullOrEmpty(grid0.Query.Filter)? "true" : grid0.Query.Filter)}",
    OrderBy = $"{grid0.Query.OrderBy}",
    Expand = "ClienteDeudum,Evento,TipoComunicacion,TipoTarea,Usuario,Usuario1",
    Select = string.Join(",", grid0.ColumnsCollection.Where(c => c.GetVisible() && !string.IsNullOrEmpty(c.Property)).Select(c => c.Property.Contains(".") ? c.Property + " as " + c.Property.Replace(".", "") : c.Property))
}, "Tareas");
        }
    }
}
