@code {
    [Parameter]
    public decimal ClienteDeudaId { get; set; }
    Reincarapp.Models.reincardb.ClienteDeuda ClienteDeuda = null;

    string errMsg = "";

    protected override async Task OnInitializedAsync()
    {
        try { 

            clienteDeudaForIdClienteDeuda = await reincardbService.GetClienteDeuda(new Query { Filter = $@"i => i.Id_Cliente_Deuda = @0", FilterParameters = new object[] { ClienteDeudaId }, Expand = "Cliente,Persona" });

            if (clienteDeudaForIdClienteDeuda.ToList().Count > 0)
            {
                ClienteDeuda = clienteDeudaForIdClienteDeuda.FirstOrDefault();
            }

            usuariosForIdUsuario = await reincardbService.GetUsuario(new Query { Filter = $@"i => i.Usuario1 = @0 || i.Correo_Electronico == @0", FilterParameters = new object[] { securityService.User.UserName } });

            usuariosForIdUsuarioTarea = await reincardbService.GetUsuario(new Query { Filter = $@"i => i.Usuario1 = @0 || i.Correo_Electronico == @0", FilterParameters = new object[] { securityService.User.UserName } });

            Reincarapp.Models.reincardb.Usuario usuario = null;

            if (usuariosForIdUsuario.ToList().Count == 1)
            {
                usuario = usuariosForIdUsuario.FirstOrDefault();
            }
            else
            {
                throw new Exception("Correo electronico del usuario esta registrado mas de una vez");
            }


            tarea = new Reincarapp.Models.reincardb.Tarea() {Id_Cliente_Deuda = ClienteDeuda.Id_Cliente_Deuda,Id_Usuario_Tarea = usuario.Id_Usuario,Id_Usuario = usuario.Id_Usuario };



            //eventosForIdEvento = await reincardbService.GetEventos();

            tipoComunicacionsForIdTipoComunicacion = await reincardbService.GetTipoComunicacion(new Query { Filter = $@"i => i.Id_Cliente = @0", FilterParameters = new object[] { ClienteDeuda.Id_Cliente } });

            tipoTareasForidTipoTarea = await reincardbService.GetTipoTarea();

        } catch (Exception ex)
        {
            errMsg = ex.Message;
            errorVisible = true;

        }


    }
    protected bool errorVisible;
    protected Reincarapp.Models.reincardb.Tarea tarea;

    protected IEnumerable<Reincarapp.Models.reincardb.ClienteDeuda> clienteDeudaForIdClienteDeuda;

    protected IEnumerable<Reincarapp.Models.reincardb.Evento> eventosForIdEvento;

    protected IEnumerable<Reincarapp.Models.reincardb.TipoComunicacion> tipoComunicacionsForIdTipoComunicacion;

    protected IEnumerable<Reincarapp.Models.reincardb.TipoTarea> tipoTareasForidTipoTarea;

    protected IEnumerable<Reincarapp.Models.reincardb.Usuario> usuariosForIdUsuario;

    protected IEnumerable<Reincarapp.Models.reincardb.Usuario> usuariosForIdUsuarioTarea;

    protected async Task FormSubmit()
    {
        try
        {

            tarea.Fecha_Creacion_Tarea = DateTime.Now;

            await reincardbService.CreateTarea(tarea);
            DialogService.Close(tarea);
        }
        catch (Exception ex)
        {
            
            hasChanges = ex is Microsoft.EntityFrameworkCore.DbUpdateConcurrencyException;
            canEdit = !(ex is Microsoft.EntityFrameworkCore.DbUpdateConcurrencyException);
            errMsg = ex.Message;
            errorVisible = true;
        }
    }

    protected async Task CancelButtonClick(MouseEventArgs args)
    {
        DialogService.Close(null);
    }


    protected bool hasChanges = false;
    protected bool canEdit = true;
}
