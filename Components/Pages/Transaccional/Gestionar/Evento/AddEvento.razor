    bool ValidateRequiredFechaComp()
    {
        var EsCompromiso = resultadoEventosForIdResultadoEvento.Where(x => x.Id_Resultado_Evento == evento.Id_Resultado_Evento).FirstOrDefault()?.es_compromiso ?? false;
        var EsRecaudo = resultadoEventosForIdResultadoEvento.Where(x => x.Id_Resultado_Evento == evento.Id_Resultado_Evento).FirstOrDefault()?.es_recaudo ?? false;

        if ((EsCompromiso || EsRecaudo) && ( evento.Fecha_Realizacion_Evento == null))
            return false;
        else
            return true;



    }

    bool ValidateRequiredMonto()
    {
        var EsCompromiso = resultadoEventosForIdResultadoEvento.Where(x => x.Id_Resultado_Evento == evento.Id_Resultado_Evento).FirstOrDefault()?.es_compromiso ?? false;
        var EsRecaudo = resultadoEventosForIdResultadoEvento.Where(x => x.Id_Resultado_Evento == evento.Id_Resultado_Evento).FirstOrDefault()?.es_recaudo ?? false;

        if ((EsCompromiso || EsRecaudo) && (evento.Monto == null))
            return false;
        else
            return true;



    }

