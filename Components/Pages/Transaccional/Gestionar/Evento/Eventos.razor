<PageTitle>Eventos</PageTitle>
<RadzenStack>
    <RadzenRow AlignItems="AlignItems.Center">
        <RadzenColumn Size="12" SizeMD="6">
            <RadzenText Text="@("Eventos")" TextStyle="TextStyle.H3" TagName="TagName.H1" style="margin: 0" />
        </RadzenColumn>
        <RadzenColumn Size="12" SizeMD="6">
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.End" Gap="0.5rem">
                <RadzenSplitButton Icon="get_app" Text="Export" Click="@ExportClick" Variant="Variant.Flat" Shade="Shade.Lighter">
                    <RadzenSplitButtonItem Text="Excel" Value="xlsx" />
                    <RadzenSplitButtonItem Text="CSV" Value="csv" />
                </RadzenSplitButton>
                <RadzenButton Icon="add_circle_outline" Text="" Click="@AddButtonClick" Variant="Variant.Flat" />
            </RadzenStack>
        </RadzenColumn>
    </RadzenRow>
    <RadzenTextBox Placeholder="Search ..." style="display: block; width: 100%" @oninput="@Search" />
    <RadzenRow>
        <RadzenColumn SizeMD="@size">
            <RadzenDataGrid @ref="grid0" ColumnWidth="200px" AllowFiltering="true" FilterMode="FilterMode.Advanced" AllowSorting="true" ShowPagingSummary="true" PageSize="20000" style="height: 600px; overflow-y: auto;"
                            Data="@eventos"
                            TItem="Reincarapp.Models.reincardb.Evento" RowDoubleClick="@EditRow">
                <Columns>
                    <RadzenDataGridColumn TItem="Reincarapp.Models.reincardb.Evento" Property="Texto_Evento" Title="Texto Evento">
                        <Template>
                            <div class="col-lg-12">
                                <div>
                                    <div class="card-body pt-0">
                                        <div class="widget-49">
                                            <div class="widget-49-title-wrapper">
                                                <div class="widget-49-date-primary">
                                                    <span class="widget-49-date-day">@(context.ClienteDeuda.ClienteDeudaCons?.FirstOrDefault()?.id_evento_mejor_gestion == context.Id_Evento ? "MG" : "")</span>
                                                </div>
                                                <div class="widget-49-meeting-info">
                                                    <span class="widget-49-pro-title">@(context.ResultadoEvento?.Nombre_Resultado_Evento)</span>
                                                    <span class="widget-49-meeting-time">@("Creado En:" + context.Fecha_Creacion_Evento.ToString("dd/MM/yyyy hh:mm tt", System.Globalization.CultureInfo.InvariantCulture) + (context.Fecha_Realizacion_Evento != null ? ", Compromiso para:" + context.Fecha_Realizacion_Evento?.ToString("dd/MM/yyyy hh:mm tt", System.Globalization.CultureInfo.InvariantCulture) : ""))</span>
                                                </div>
                                            </div>
                                            <ol class="widget-49-meeting-points">
                                                <li class="widget-49-meeting-item"><span style="white-space:pre-wrap; width:100%; font-size: medium;font-weight: bolder;">@(context.Texto_Evento)</span></li>
                                                <li class="widget-49-meeting-item"><span style="white-space:pre-wrap; width:100%">@("Resultado: " + context.ResultadoEvento?.Nombre_Resultado_Evento)</span></li>
                                                <li class="widget-49-meeting-item"><span style="white-space:pre-wrap; width:100%">@("Tipo Comunicacion: " + context.TipoComunicacion?.Nombre_Tipo_Comunicacion)</span></li>
                                                <li class="widget-49-meeting-item"><span style="white-space:pre-wrap; width:100%">@("Creado Por: " + context.Usuario1?.Nombre_Usuario)</span></li>
                                                @foreach (var e in context.EventoArchivo)
                                                {
                                                    <li class="widget-49-meeting-item">
                                                        <span>@(e.nomb_archivo_ext)</span>
                                                    </li>
                                                }
                                            </ol>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </Template>
                    </RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>
        </RadzenColumn>

        <RadzenColumn SizeMD="@size" Visible="@addEvento">
            <Reincarapp.Components.Pages.Transaccional.Gestionar.Evento.AddEvento ClienteDeudaId="@ClienteDeudaId" IdNegocio="@IdNegocio" EnabledDisabledParent="@ChildFiredEvent" screen="@("gestionar")"></Reincarapp.Components.Pages.Transaccional.Gestionar.Evento.AddEvento>
        </RadzenColumn>
    </RadzenRow>
</RadzenStack>

@code {
    protected IEnumerable<Reincarapp.Models.reincardb.Evento> eventos;
    protected RadzenDataGrid<Reincarapp.Models.reincardb.Evento> grid0;
    protected string search = "";
    
    private int size = 12;
    private bool addEvento = false;
    private reincardbContext db;
    private bool _isLoading = false;

    [Parameter]
    public long ClienteDeudaId { get; set; }

    [Parameter]
    public string IdNegocio { get; set; }

    [Parameter]
    public Action<Reincarapp.Models.reincardb.DatoPersona> EnabledDisabledParent { get; set; }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            Logger.LogInformation("Inicializando componente Eventos para ClienteDeudaId: {ClienteDeudaId}", ClienteDeudaId);
            
            db = await _contextFactory.CreateDbContextAsync();
            await LoadData();
            
            Logger.LogInformation("Componente Eventos inicializado correctamente. Total eventos: {Count}", eventos?.Count() ?? 0);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error al inicializar componente Eventos para ClienteDeudaId: {ClienteDeudaId}", ClienteDeudaId);
            
            await ShowErrorNotification("Error al cargar eventos", ex.Message);
        }
    }

    private async Task LoadData()
    {
        try
        {
            if (_isLoading)
            {
                Logger.LogWarning("LoadData ya está en ejecución, omitiendo llamada duplicada");
                return;
            }

            _isLoading = true;
            Logger.LogInformation("Cargando eventos para ClienteDeudaId: {ClienteDeudaId}", ClienteDeudaId);

            using var context = await _contextFactory.CreateDbContextAsync();
            
            eventos = (await context.Evento
                .AsNoTracking()
                .Include(x => x.ClienteDeuda)
                    .ThenInclude(x => x.ClienteDeudaCons)
                .Include(x => x.EventoArchivo)
                .Include(x => x.Usuario)
                .Include(x => x.Usuario1)
                .Include(x => x.ResultadoEvento)
                .Include(x => x.TipoComunicacion)
                .Where(x => x.Id_Cliente_Deuda == ClienteDeudaId)
                .ToListAsync())
                .OrderByDescending(x => x.Fecha_Creacion_Evento);

            Logger.LogInformation("Eventos cargados exitosamente. Total: {Count}", eventos?.Count() ?? 0);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error al cargar datos de eventos para ClienteDeudaId: {ClienteDeudaId}", ClienteDeudaId);
            
            eventos = Enumerable.Empty<Reincarapp.Models.reincardb.Evento>();
            await ShowErrorNotification("Error al cargar datos", ex.Message);
        }
        finally
        {
            _isLoading = false;
        }
    }

    protected async Task Search(ChangeEventArgs args)
    {
        try
        {
            search = $"{args.Value}";
            Logger.LogInformation("Buscando eventos con término: {SearchTerm}", search);

            await grid0.GoToPage(0);

            using var context = await _contextFactory.CreateDbContextAsync();
            
            eventos = (await context.Evento
                .AsNoTracking()
                .Where(x => x.Texto_Evento.Contains(search) && x.Id_Cliente_Deuda == ClienteDeudaId)
                .Include(x => x.ClienteDeuda)
                    .ThenInclude(x => x.ClienteDeudaCons)
                .Include(x => x.EventoArchivo)
                .Include(x => x.Usuario)
                .Include(x => x.Usuario1)
                .Include(x => x.ResultadoEvento)
                .Include(x => x.TipoComunicacion)
                .ToListAsync())
                .OrderByDescending(x => x.Fecha_Creacion_Evento);

            Logger.LogInformation("Búsqueda completada. Resultados: {Count}", eventos?.Count() ?? 0);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error al buscar eventos con término: {SearchTerm}", search);
            await ShowErrorNotification("Error en búsqueda", ex.Message);
        }
    }

    private async void ChildFiredEvent(bool _res)
    {
        try
        {
            Logger.LogInformation("Evento hijo disparado. Recargando datos...");
            
            size = 12;
            addEvento = false;
            
            await Task.Delay(100);
            await LoadData();
            
            if (grid0 != null)
            {
                await grid0.Reload();
            }
            
            await InvokeAsync(() => StateHasChanged());
            
            Logger.LogInformation("Datos recargados exitosamente después de evento hijo");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error al procesar evento hijo");
            await ShowErrorNotification("Error al actualizar", ex.Message);
        }
    }

    protected void OnRowClick(DataGridRowMouseEventArgs<Reincarapp.Models.reincardb.DatoPersona> args)
    {
        try
        {
            EnabledDisabledParent?.Invoke(args.Data);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error al procesar clic en fila");
        }
    }

    protected async Task AddButtonClick(MouseEventArgs args)
    {
        try
        {
            Logger.LogInformation("Abriendo formulario para agregar nuevo evento");
            
            size = 6;
            addEvento = true;
            
            await InvokeAsync(() => StateHasChanged());
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error al abrir formulario de nuevo evento");
            await ShowErrorNotification("Error", "No se pudo abrir el formulario");
        }
    }

    protected async Task EditRow(DataGridRowMouseEventArgs<Reincarapp.Models.reincardb.Evento> args)
    {
        try
        {
            Logger.LogInformation("Abriendo editor para evento ID: {EventoId}", args.Data.Id_Evento);
            
            await DialogService.OpenAsync<EditEvento>(
                "Edit Evento",
                new Dictionary<string, object> { { "Id_Evento", args.Data.Id_Evento } },
                new DialogOptions() { Draggable = true }
            );
            
            await LoadData();
            
            if (grid0 != null)
            {
                await grid0.Reload();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error al editar evento ID: {EventoId}", args.Data?.Id_Evento);
            await ShowErrorNotification("Error al editar", ex.Message);
        }
    }

    protected async Task GridDeleteButtonClick(MouseEventArgs args, Reincarapp.Models.reincardb.Evento evento)
    {
        try
        {
            Logger.LogInformation("Intentando eliminar evento ID: {EventoId}", evento.Id_Evento);
            
            if (await DialogService.Confirm("¿Está seguro que desea eliminar este registro?") == true)
            {
                var deleteResult = await reincardbService.DeleteEvento(evento.Id_Evento);

                if (deleteResult != null)
                {
                    Logger.LogInformation("Evento eliminado exitosamente ID: {EventoId}", evento.Id_Evento);
                    
                    await LoadData();
                    
                    if (grid0 != null)
                    {
                        await grid0.Reload();
                    }
                    
                    NotificationService.Notify(new NotificationMessage
                    {
                        Severity = NotificationSeverity.Success,
                        Summary = "Éxito",
                        Detail = "Evento eliminado correctamente",
                        Duration = 3000
                    });
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error al eliminar evento ID: {EventoId}", evento?.Id_Evento);
            
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Error",
                Detail = $"No se pudo eliminar el evento: {ex.Message}",
                Duration = 5000
            });
        }
    }

    protected async Task ExportClick(RadzenSplitButtonItem args)
    {
        try
        {
            Logger.LogInformation("Exportando eventos a formato: {Format}", args?.Value ?? "xlsx");

            if (args?.Value == "csv")
            {
                await reincardbService.ExportEventoToCSV(new Query
                {
                    Filter = $@"{(string.IsNullOrEmpty(grid0.Query.Filter) ? "true" : grid0.Query.Filter)}",
                    OrderBy = $"{grid0.Query.OrderBy}",
                    Expand = "ClasificacionAdicional,ClasificacionAdicional1,ClasificacionAdicional2,ClasificacionAdicional3,ClienteDeudum,DatoPersona,ClasificacionAdicional4,ClasificacionAdicional5,Municipio,ClasificacionAdicional6,ClasificacionAdicional7,ResultadoEvento,Tarea,TipoComunicacion,ClasificacionAdicional8,Usuario,Usuario1",
                    Select = string.Join(",", grid0.ColumnsCollection.Where(c => c.GetVisible() && !string.IsNullOrEmpty(c.Property)).Select(c => c.Property.Contains(".") ? c.Property + " as " + c.Property.Replace(".", "") : c.Property))
                }, "Eventos");
            }
            else
            {
                await reincardbService.ExportEventoToExcel(new Query
                {
                    Filter = $@"{(string.IsNullOrEmpty(grid0.Query.Filter) ? "true" : grid0.Query.Filter)}",
                    OrderBy = $"{grid0.Query.OrderBy}",
                    Expand = "ClasificacionAdicional,ClasificacionAdicional1,ClasificacionAdicional2,ClasificacionAdicional3,ClienteDeudum,DatoPersona,ClasificacionAdicional4,ClasificacionAdicional5,Municipio,ClasificacionAdicional6,ClasificacionAdicional7,ResultadoEvento,Tarea,TipoComunicacion,ClasificacionAdicional8,Usuario,Usuario1",
                    Select = string.Join(",", grid0.ColumnsCollection.Where(c => c.GetVisible() && !string.IsNullOrEmpty(c.Property)).Select(c => c.Property.Contains(".") ? c.Property + " as " + c.Property.Replace(".", "") : c.Property))
                }, "Eventos");
            }

            Logger.LogInformation("Exportación completada exitosamente");
            
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Success,
                Summary = "Exportación exitosa",
                Detail = "Los datos se han exportado correctamente",
                Duration = 3000
            });
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error al exportar eventos");
            await ShowErrorNotification("Error al exportar", ex.Message);
        }
    }

    private async Task ShowErrorNotification(string summary, string detail)
    {
        await InvokeAsync(() =>
        {
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = summary,
                Detail = detail,
                Duration = 5000
            });
        });
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (db != null)
            {
                await db.DisposeAsync();
                Logger.LogInformation("DbContext dispuesto correctamente");
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error al disponer DbContext");
        }
    }
}
