    {
        //eventos = (await db.Eventos.Include(x => x.EventoArchivos).Include(x => x.Usuario).Include(x => x.Usuario1).Where(x => x.Id_Cliente_Deuda == ClienteDeudaId).ToListAsync()).OrderByDescending(x => x.Fecha_Creacion_Evento); //await reincardbService.GetEventos(new Query { Filter = $@"i =>  id_cliente_deuda = @1", FilterParameters = new object[] { search, ClienteDeudaId } });


