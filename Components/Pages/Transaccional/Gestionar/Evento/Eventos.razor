    protected async Task GridDeleteButtonClick(MouseEventArgs args, Reincarapp.Models.reincardb.Evento evento)
    {
        try
        {
            if (await DialogService.Confirm("Are you sure you want to delete this record?") == true)
            {
                var deleteResult = await reincardbService.DeleteEvento(evento.Id_Evento);

                if (deleteResult != null)
                {
                    await grid0.Reload();
                }
            }
        }
        catch (Exception ex)
        {
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = $"Error",
                Detail = $"Unable to delete Evento"
            });
        }
    }

