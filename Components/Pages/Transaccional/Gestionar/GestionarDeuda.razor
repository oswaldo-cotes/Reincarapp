                    </ChildContent>
                    
                </RadzenTabsItem>
                <RadzenTabsItem Text="@($"Tareas({registro.Tarea?.Count().ToString()})")">
                    <Reincarapp.Components.Pages.Transaccional.Gestionar.Tareas.Tareas ClienteDeudaId="@ClienteDeudaId" />
                </RadzenTabsItem>

            </Tabs>
          </RadzenTabs>
            

    </RadzenColumn>

   @*  <RadzenColumn Size="@size" Visible="@addEvento">

        <Reincarapp.Pages.Transaccional.Gestionar.Evento.AddEvento ClienteDeudaId="@ClienteDeudaId" IdNegocio="@IdNegocio" ></Reincarapp.Pages.Transaccional.Gestionar.Evento.AddEvento>

    </RadzenColumn> *@

   @*  <RadzenColumn Size="4">
       <Reincarapp.Pages.Transaccional.Gestionar.Evento.Eventos ClienteDeudaId="@ClienteDeudaId" IdNegocio ="@IdNegocio" EnabledDisabledParent="@ChildFiredEvent" />
    </RadzenColumn>
    <RadzenColumn Size="4">
        <Reincarapp.Pages.Transaccional.Gestionar.Tareas.Tareas ClienteDeudaId="@ClienteDeudaId" />
    </RadzenColumn> *@
</RadzenRow>



@code {

    [Parameter]
    public Models.reincardb.ClienteDeuda registro { get; set; }
        
    long ClienteDeudaId = 0;
    string IdNegocio = "";

    List<Dictionary<string, object>> values = new List<Dictionary<string, object>>();

    List<Dictionary<string, object>> otherValues = new List<Dictionary<string, object>>();

    int size = 6;
    bool addEvento = false;

  

    async void ChildFiredEvent(Reincarapp.Models.reincardb.DatoPersona persona)
    {

        addEvento = false;

        this.StateHasChanged();
        //AddDialog = false;

        // dialogService.Close();
        // registros = await ctxEsp.GetPD(decimal.Parse(ParentId));
        // await grid.Reload();
        // this.StateHasChanged();

        // EnabledDisabledParent(true);
    }

    protected async override Task OnInitializedAsync()
    {
        var startDate = new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1);
        var endDate = startDate.AddMonths(1).AddDays(-1);
        ClienteDeudaId = registro.Id_Cliente_Deuda; //long.Parse(registro.GetType().GetProperty("id_cliente_deuda").GetValue(registro, null).ToString());

        var clienteDeudaDato = registro.ClienteDeudaDato.ToList()[0];

        using var context = await dbContextFactory.CreateDbContextAsync();

        var registros = await context.ClienteDeudaDato
            .AsNoTracking()
           
            .Where(x => x.Id != clienteDeudaDato.Id && x.Id_Cliente_Deuda == ClienteDeudaId &&
                   x.Fecha_Final == null &&
                   x.Fecha_Inicial >= startDate &&
                   x.Fecha_Inicial <= endDate).ToListAsync();



        values.Add(JsonConvert.DeserializeObject<Dictionary<string, object>>(clienteDeudaDato.Dato));

        foreach (var item in registros)
        {
            values.Add(JsonConvert.DeserializeObject<Dictionary<string, object>>(item.Dato));
        }

       
    }

}
