@inherits LayoutComponentBase
@inject CookieThemeService CookieThemeService
<RadzenComponents />

<RadzenLayout>
    <RadzenHeader>
        <RadzenRow JustifyContent="JustifyContent.Start" AlignItems="AlignItems.Center" Gap="0">
            <RadzenColumn Size="5">
                <RadzenSidebarToggle Click="@SidebarToggleClick"></RadzenSidebarToggle>
            </RadzenColumn>
            <RadzenColumn Size="7">
                <RadzenStack AlignItems="AlignItems.Center" Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" class="rz-px-2">
                    <RadzenAppearanceToggle />
                    <RadzenProfileMenu Visible="@Security.IsAuthenticated()" Click="@ProfileMenuClick">
                        <ChildContent>

                            <RadzenProfileMenuItem Path="profile" Icon="settings" Text="Profile" />
                            <RadzenProfileMenuItem Path="application-users" Icon="person" Text="Users" Visible="@Security.IsInRole(new string[] { "Administrador" })" />
                            <RadzenProfileMenuItem Path="application-roles" Icon="security" Text="Roles" Visible="@Security.IsInRole(new string[] { "Administrador" })" />
                            <RadzenProfileMenuItem Text="Logout" Value="Logout" Icon="power_settings_new" />
                        </ChildContent>
                        <Template>
                            @Security.User?.Name
                            <RadzenGravatar Email="@Security.User?.Name" />
                        </Template>
                    </RadzenProfileMenu>
                </RadzenStack>
            </RadzenColumn>
        </RadzenRow>
    </RadzenHeader>
    <RadzenBody Expanded="@sidebarExpanded">
        <RadzenRow class="rz-mx-auto rz-px-4 rz-pt-2 rz-pt-md-4 rz-pt-lg-6 rz-pt-xl-12 rz-pb-2 rz-pb-lg-12" Style="max-width: 1440px;">
            <RadzenColumn Size="12">
            @Body
            </RadzenColumn>
        </RadzenRow>
    </RadzenBody>
    <RadzenSidebar @bind-Expanded="@sidebarExpanded">
        <RadzenStack AlignItems="Radzen.AlignItems.Center" class="rz-py-4 rz-py-lg-6" Style="padding: var(--rz-panel-menu-item-padding); border-bottom: var(--rz-panel-menu-item-border);">
            <RadzenImage Path="images/logo.png"  style="width: 48px; height: 48px;" AlternateText="Application logo"></RadzenImage>
            <RadzenText Text="Reincarapp" TextStyle="Radzen.Blazor.TextStyle.Subtitle1" class="rz-mb-0" style="color: var(--rz-sidebar-color);" />
        </RadzenStack>

        <RadzenPanelMenu>
            <RadzenPanelMenuItem Text="Home" Path="" />
            <RadzenPanelMenuItem Text="Configuracion" Visible="@Security.IsInRole(new string[] { "Administrador" })">
                <RadzenPanelMenuItem Text="Clientes" Path="clientes" />
               @*  <RadzenPanelMenuItem Text="Asignar CLientes a usuarios" Path="usuario-cliente2" /> *@
                <RadzenPanelMenuItem Text="Bases" Path="bases" />
                <RadzenPanelMenuItem Text="Resultado Evento" Path="resultado-eventos" />
                <RadzenPanelMenuItem Text="Tipo Comunicacion" Path="tipo-comunicacions" />
                <RadzenPanelMenuItem Text="Clasificacion Adicional" Path="clasificacion-adicionals" />
              @*   <RadzenPanelMenuItem Text="Seguridad y Accesos" Path="">
                    <RadzenPanelMenuItem Text="Usuarios" Path="usuarios" />
                    <RadzenPanelMenuItem Text="Roles Usuarios" Path="usuario-rols" />
                    <RadzenPanelMenuItem Text="Clientes Usuarios" Path="usuario-clientes" />
                </RadzenPanelMenuItem> *@
            </RadzenPanelMenuItem>
      
            <RadzenPanelMenuItem Text="Personas" Path="personas" Visible="@Security.IsInRole(new string[] { "Administrador", "Consulta" })" />
            <RadzenPanelMenuItem Text="Gestionar" Path="cliente-deuda" Visible="@(Security.IsAuthenticated())">
            </RadzenPanelMenuItem>
            <RadzenPanelMenuItem Text="Informes"  Visible="@Security.IsInRole(new string[] { "Administrador", "Coordinador Cartera" })">
                <RadzenPanelMenuItem Text="Descarga de informes" Path="informesdesc" />
                <RadzenPanelMenuItem Text="Informes" Path="nuevosinformes" />
            </RadzenPanelMenuItem>

            <RadzenPanelMenuItem Text="Cargue"  Visible="@Security.IsInRole(new string[] { "Administrador", "Coordinador Cartera" })">
                <RadzenPanelMenuItem Text="Cargar Base" Path="carguedatos" />
            </RadzenPanelMenuItem>
            @*    *@
          



        </RadzenPanelMenu>

       
        <RadzenStack AlignItems="Radzen.AlignItems.Center" Gap="0" class="rz-py-4 rz-py-lg-6" Style="padding: var(--rz-panel-menu-item-padding);">
            <RadzenText Text="Reincarapp v1.0.0" TextStyle="Radzen.Blazor.TextStyle.Caption" TagName="Radzen.Blazor.TagName.P" TextAlign="Radzen.TextAlign.Center" />
            <RadzenText Text="Copyright Ⓒ 2026" TextStyle="Radzen.Blazor.TextStyle.Caption" class="rz-mb-0" TagName="Radzen.Blazor.TagName.P" TextAlign="Radzen.TextAlign.Center" />
        </RadzenStack>
    </RadzenSidebar>
</RadzenLayout>
